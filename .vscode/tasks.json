{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Run NASM (current file)",
            "type": "shell",
            "command": "nasm -f elf64 -g '${file}' -o '${fileDirname}/${fileBasenameNoExtension}.o' && ld '${fileDirname}/${fileBasenameNoExtension}.o' -o '${fileDirname}/${fileBasenameNoExtension}' && '${fileDirname}/${fileBasenameNoExtension}'",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}